{
  "name": "uefi-editor",
  "private": true,
  "version": "0.5.0",
  "description": "Browser-based AMI Aptio IV/V HII and IFR editor",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "case:add": "node scripts/case-review.mjs add",
    "case:check": "node scripts/case-review.mjs check && node scripts/case-review.test.mjs",
    "check": "npm run format:check && npm run lint && npm run case:check && npm run test:coverage && npm run build",
    "preview": "vite preview",
    "firmware:acceptance": "vitest run --config scripts/firmware-acceptance.config.mjs",
    "firmware:codec-integration": "vitest run --config scripts/firmware-codec-integration.config.mjs"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "dependencies": {
    "@alexaltea/capstone-js": "^5.0.9",
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@kirinsaninc/lhats": "^0.1.0",
    "@mantine/core": "^7.17.2",
    "@mantine/hooks": "^7.17.2",
    "@tabler/icons-react": "^3.49.0",
    "file-saver": "^2.0.5",
    "immer": "^11.1.21",
    "lzma": "2.3.2",
    "react": "^19",
    "react-dom": "^19",
    "use-immer": "^0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/file-saver": "^2.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9",
    "eslint-plugin-react-dom": "^5.24.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-react-x": "^1.40.1",
    "globals": "^16",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.29",
    "postcss-preset-mantine": "^1.12.3",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.9",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6",
    "vite-plugin-checker": "^0.14",
    "vitest": "^3.2.7"
  }
}
